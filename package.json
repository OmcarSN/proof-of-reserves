{
  "name": "proof-of-reserves",
  "version": "0.1.0",
  "description": "Proof of Reserves on Midnight — proves assets >= liabilities without revealing amounts, balances, or addresses",
  "type": "module",
  "scripts": {
    "build": "compact compile contracts/proof-of-reserves.compact managed",
    "compile:wsl": "wsl -e bash -lc \"cd /mnt/c/Users/Devyani/proof-of-reserves && compact compile contracts/proof-of-reserves.compact managed\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:seed": "node scripts/gen-seed.mjs",
    "deploy:preprod": "cross-env NODE_OPTIONS=--max-old-space-size=16384 tsx deploy/deploy.ts preprod",
    "deploy:preview": "cross-env NODE_OPTIONS=--max-old-space-size=16384 tsx deploy/deploy.ts preview"
  },
  "devDependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0"
  },
  "dependencies": {
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/midnight-js": "^4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "^4.1.1",
    "@midnight-ntwrk/wallet-sdk-address-format": "^3.1.2",
    "@midnight-ntwrk/wallet-sdk-dust-wallet": "^4.1.0",
    "@midnight-ntwrk/wallet-sdk-facade": "^4.0.1",
    "@midnight-ntwrk/wallet-sdk-hd": "^3.0.2",
    "@midnight-ntwrk/wallet-sdk-shielded": "^3.0.1",
    "@midnight-ntwrk/wallet-sdk-unshielded-wallet": "^3.1.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "ws": "^8.21.1"
  }
}
